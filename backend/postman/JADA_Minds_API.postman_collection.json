    {
      "name": "Specialists",
      "item": [
        {
          "name": "List Specialists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/specialists?specialization=Counseling",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "specialists"
              ],
              "query": [
                {
                  "key": "specialization",
                  "value": "Counseling"
                }
              ]
            },
            "description": "Approved specialists only. specialization query param is optional."
          },
          "response": []
        },
        {
          "name": "Get Specialist by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/specialists/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "specialists",
                "1"
              ]
            },
            "description": "404 if not approved (not 403) - an unapproved profile looks like it doesn't exist."
          },
          "response": []
        },
        {
          "name": "Submit Specialist Application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/specialists",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "specialists"
              ]
            },
            "description": "Requires a token belonging to a role=specialist account. 403 otherwise. 400 if you already have an application.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"specialization\": \"Counseling\",\n    \"bio\": \"Licensed counselor with 5 years experience.\",\n    \"registration_number\": \"REG-001\",\n    \"national_id_url\": \"https://example.com/id.pdf\",\n    \"degree_certificate_url\": \"https://example.com/degree.pdf\",\n    \"professional_license_url\": \"https://example.com/license.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get My Specialist Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/specialists/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "specialists",
                "me"
              ]
            },
            "description": "Your own application, including verification_status. 404 if you haven't applied."
          },
          "response": []
        },
        {
          "name": "Update My Specialist Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/specialists/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "specialists",
                "me"
              ]
            },
            "description": "specialization/bio only - not documents or verification_status.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"bio\": \"Updated bio.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ],
      "description": ""
