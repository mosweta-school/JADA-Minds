{
  "info": {
    "name": "JADA Minds API",
    "description": "Covers every endpoint built for Member 4's modules: Questions, Assessments, Results & Progress, Resources, Specialists, and Workshops.\n\nSETUP:\n1. Set the `base_url` collection variable (defaults to http://127.0.0.1:5000 for local dev).\n2. There's no /login endpoint yet, so get a token by running `python seed.py` in the backend folder and copying the printed token into the `token` collection variable.\n3. All requests inherit a Bearer auth using {{token}} - no need to set the Authorization header per-request.\n\nSwap the `token` variable for a real one from Deogracious's /login once it exists - nothing else in this collection needs to change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Questions",
      "item": [
        {
          "name": "List Questions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions"
              ]
            },
            "description": "Active question bank, ordered by category and display_order. Requires any valid token."
          },
          "response": []
        },
        {
          "name": "Create Question (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/questions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions"
              ]
            },
            "description": "Admin only - 403 for non-admin tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"question_text\": \"I feel overwhelmed\",\n    \"category\": \"stress\",\n    \"weight\": 1,\n    \"display_order\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update Question (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/questions/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                "1"
              ]
            },
            "description": "Admin only. Partial update - send only the fields you're changing.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"question_text\": \"I feel very overwhelmed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Retire Question (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/questions/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                "1"
              ]
            },
            "description": "Admin only. Soft delete - sets is_active=False, does not remove the row (protects historical assessment_responses)."
          },
          "response": []
        }
      ],
      "description": ""
    },
    {
      "name": "Assessments",
      "item": [
        {
          "name": "Submit Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/assessment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "assessment"
              ]
            },
            "description": "selected_option must be one of: Never, Rarely, Sometimes, Often, Always.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"responses\": [\n        {\n            \"question_id\": 1,\n            \"selected_option\": \"Often\"\n        },\n        {\n            \"question_id\": 2,\n            \"selected_option\": \"Rarely\"\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get Assessment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/assessment/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "assessment",
                "1"
              ]
            },
            "description": "Only returns your own assessment - 403 if it belongs to someone else, 404 if it doesn't exist."
          },
          "response": []
        }
      ],
      "description": ""
    },
